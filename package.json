{
  "name": "court-feel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Court Feel - a 3D volleyball feel sandbox in the browser",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "node scripts/e2e.mjs",
    "levels": "node scripts/levels.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "license": "MIT",
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
